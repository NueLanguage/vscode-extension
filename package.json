{
	"name": "nue-vscode",
	"displayName": "Nue",
	"description": "Syntax highlighting and basic editing support for Nue.",
	"icon": "images/nue.png",
	"version": "0.2.0",
	"publisher": "NueLanguage",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"nue",
		"numelon",
		"programming language"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/NueLanguage/vscode-extension.git"
	},
	"bugs": {
		"url": "https://github.com/NueLanguage/vscode-extension/issues"
	},
	"homepage": "https://github.com/NueLanguage/vscode-extension",
	"preview": true,
	"contributes": {
		"languages": [
			{
				"id": "nue",
				"aliases": [
					"Nue",
					"nue"
				],
				"extensions": [
					".nue"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "nue",
				"scopeName": "source.nue",
				"path": "./syntaxes/nue.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"test": "node --test test/grammar.test.mjs",
		"package": "npm test && npx --yes @vscode/vsce@4.0.0 package"
	},
	"devDependencies": {
		"vscode-oniguruma": "2.0.1",
		"vscode-textmate": "9.3.2"
	}
}
