{
	"name": "nue-vscode",
	"displayName": "Nue",
	"description": "Syntax highlighting and formatting support for Nue.",
	"icon": "images/nue.png",
	"version": "0.3.0",
	"publisher": "NueLanguage",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"nue",
		"numelon",
		"programming language"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/NueLanguage/vscode-extension.git"
	},
	"bugs": {
		"url": "https://github.com/NueLanguage/vscode-extension/issues"
	},
	"homepage": "https://github.com/NueLanguage/vscode-extension",
	"preview": true,
	"main": "./src/extension.cjs",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"onLanguage:nue"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Highlighting is available, but running Nue to format documents requires a trusted workspace.",
			"restrictedConfigurations": [
				"nue.executablePath"
			]
		}
	},
	"contributes": {
		"configuration": {
			"title": "Nue",
			"properties": {
				"nue.executablePath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"description": "Path to a prebuilt Nue executable supporting fmt. If empty, use nue from PATH on the extension host. An absolute path should probably be used."
				}
			}
		},
		"languages": [
			{
				"id": "nue",
				"aliases": [
					"Nue",
					"nue"
				],
				"extensions": [
					".nue"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "nue",
				"scopeName": "source.nue",
				"path": "./syntaxes/nue.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"test:editor": "node test/run-editor.mjs",
		"package": "npm test && npx --yes @vscode/vsce@4.0.0 package"
	},
	"devDependencies": {
		"vscode-oniguruma": "2.0.1",
		"vscode-textmate": "9.3.2"
	}
}
